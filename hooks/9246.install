<?php

use Drupal\user\Entity\User;
use Drupal\shortcut\Entity\Shortcut;
use Symfony\Component\Yaml\Yaml;
use Drupal\Core\Config\FileStorage;

/* Place just the php of the hook below.  Do not include the function here. */

$config_storage = \Drupal::service('config.storage');
$config_name = 'views.view.eck_entities';

// Get the path to the installation profile using ExtensionPathResolver.
$extension_path_resolver = \Drupal::service('extension.path.resolver');
$profile_path = $extension_path_resolver->getPath('profile', 'uky_base') . '/config/install/' . $config_name . '.yml';

// Check if the configuration file exists.
if (file_exists($profile_path)) {
  // Parse the YAML file and import its data.
  $config_data = Yaml::parse(file_get_contents($profile_path));

  if (!empty($config_data)) {
    $config_storage->write($config_name, $config_data);
    \Drupal::logger('uky_base')->notice("The 'eck_entities' view configuration has been imported.");
  }
  else {
    \Drupal::logger('uky_base')->warning("The 'eck_entities' view configuration file is empty or invalid.");
  }
}
else {
  \Drupal::logger('uky_base')->error("The 'eck_entities' view configuration file was not found at: $profile_path");
}

