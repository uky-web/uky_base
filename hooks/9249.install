        'progress_indicator' => 'throbber',
      ],
      'third_party_settings' => [],
    ],
    'field_tags' => [
      'type' => 'chosen_select',
      'weight' => 26,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
