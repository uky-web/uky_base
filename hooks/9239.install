<?php

use Drupal\user\Entity\User;
use Drupal\shortcut\Entity\Shortcut;
use Symfony\Component\Yaml\Yaml;
use Drupal\Core\Config\FileStorage;

/* Place just the php of the hook below.  Do not include the function here. */

$config_factory = \Drupal::configFactory();

// Define the configurations for each content type.
$updates = [
  'core.entity_form_display.node.page.default' => [
    'field_paragraphs' => [
      'type' => 'paragraphs',
      'weight' => 3,
      'region' => 'content',
    ],
    'field_prefix_paragraphs' => [
      'type' => 'paragraphs',
      'weight' => 2,
      'region' => 'content',
    ],
    'field_suffix_paragraphs' => [
      'type' => 'paragraphs',
      'weight' => 4,
      'region' => 'content',
    ],
  ],
  'core.entity_form_display.node.news.default' => [
    'field_paragraphs' => [
      'type' => 'paragraphs',
      'weight' => 29,
      'region' => 'content',
    ],
  ],
  'core.entity_form_display.node.event.default' => [
    'field_paragraphs' => [
      'type' => 'paragraphs',
      'weight' => 29,
      'region' => 'content',
    ],
  ],
];

// Common settings to apply to all paragraph fields.
$common_settings = [
  'settings' => [
    'title' => 'Paragraph',
    'title_plural' => 'Paragraphs',
    'edit_mode' => 'closed',
    'closed_mode' => 'summary',
    'autocollapse' => 'none',
    'closed_mode_threshold' => 0,
    'add_mode' => 'dropdown',
    'form_display_mode' => 'default',
    'default_paragraph_type' => '_none',
    'features' => [
      'add_above' => '0',
      'collapse_edit_all' => 'collapse_edit_all',
      'convert' => '0',
      'duplicate' => '0',
    ],
  ],
  'third_party_settings' => [
    'paragraphs_previewer_popup' => [
      'enable' => '1',
    ],
  ],
];

// Loop through each config and update the necessary fields.
foreach ($updates as $config_name => $fields) {
  $config = $config_factory->getEditable($config_name);

  if ($config) {
    foreach ($fields as $field_name => $field_values) {
      $config->set("content.$field_name", array_merge($field_values, $common_settings));
    }
    $config->save();
  }
}





